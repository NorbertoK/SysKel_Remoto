<?xml version="1.0" encoding="utf-8"?>

<xs:schema xmlns="http://tempuri.org/DsPrestacion.xsd" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata"
           xmlns:mstns="http://tempuri.org/DsPrestacion.xsd" attributeFormDefault="qualified"
           elementFormDefault="qualified" targetNamespace="http://tempuri.org/DsPrestacion.xsd" id="DsPrestacion"
           xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element msdata:IsDataSet="true" msdata:UseCurrentLocale="true" name="DsPrestacion">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="Prestaciones">
          <xs:complexType>
            <xs:sequence>
              <xs:element msdata:ReadOnly="true" msdata:AutoIncrementSeed="1" msdata:AutoIncrementStep="-1"
                          name="idPrestacion" type="xs:int" />
              <xs:element name="Numero">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="15" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="Tomada" type="xs:dateTime" />
              <xs:element minOccurs="0" name="idTomador" type="xs:int" />
              <xs:element minOccurs="0" name="idMotivoDeCancelacion" type="xs:int" />
              <xs:element minOccurs="0" name="ObservacionesTomador">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="2147483647" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element minOccurs="0" name="Telefono">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="50" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="VistaPorElDespachador" type="xs:boolean" />
              <xs:element minOccurs="0" name="Agendada" type="xs:dateTime" />
              <xs:element name="Terminada" type="xs:boolean" />
              <xs:element minOccurs="0" name="idCodigo" type="xs:int" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:choice>
    </xs:complexType>
    <xs:unique msdata:PrimaryKey="true" name="Constraint1">
      <xs:selector xpath=".//mstns:Prestaciones" />
      <xs:field xpath="mstns:idPrestacion" />
    </xs:unique>
  </xs:element>
</xs:schema>