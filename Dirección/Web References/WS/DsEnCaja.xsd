<?xml version="1.0" encoding="utf-8"?>

<xs:schema xmlns="http://tempuri.org/DsEnCaja.xsd" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata"
           xmlns:mstns="http://tempuri.org/DsEnCaja.xsd" attributeFormDefault="qualified"
           elementFormDefault="qualified" targetNamespace="http://tempuri.org/DsEnCaja.xsd" id="DsEnCaja"
           xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element msdata:IsDataSet="true" msdata:UseCurrentLocale="true" name="DsEnCaja">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="EnCaja">
          <xs:complexType>
            <xs:sequence>
              <xs:element minOccurs="0" name="idValorRemesa" type="xs:int" />
              <xs:element minOccurs="0" name="idTipoDeValor" type="xs:int" />
              <xs:element minOccurs="0" name="Importe" type="xs:decimal" />
              <xs:element minOccurs="0" name="idBanco">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="50" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element minOccurs="0" name="NumeroDeCheque">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="15" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element minOccurs="0" name="Vencimiento" type="xs:dateTime" />
              <xs:element minOccurs="0" name="Observaciones">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="2147483647" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element minOccurs="0" name="Transferido" type="xs:boolean" />
              <xs:element minOccurs="0" name="ImporteTransferido" type="xs:decimal" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:choice>
    </xs:complexType>
  </xs:element>
</xs:schema>