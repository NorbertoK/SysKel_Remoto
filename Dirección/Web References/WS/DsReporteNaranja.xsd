<?xml version="1.0" encoding="utf-8"?>

<xs:schema xmlns="http://tempuri.org/DsReporteNaranja.xsd" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata"
           xmlns:mstns="http://tempuri.org/DsReporteNaranja.xsd" attributeFormDefault="qualified"
           elementFormDefault="qualified" targetNamespace="http://tempuri.org/DsReporteNaranja.xsd"
           id="DsReporteNaranja" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element msdata:IsDataSet="true" msdata:UseCurrentLocale="true" name="DsReporteNaranja">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="ReporteNARANJA">
          <xs:complexType>
            <xs:sequence>
              <xs:element msdata:ReadOnly="true" minOccurs="0" name="Registro">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="129" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="ReporteNaranjaInforme">
          <xs:complexType>
            <xs:sequence>
              <xs:element minOccurs="0" name="NumeroTarjeta">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="30" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element minOccurs="0" name="NombreTitularTarjeta">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="50" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element minOccurs="0" name="NumeroDocumentoTitularTarjeta">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="20" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element msdata:ReadOnly="true" minOccurs="0" name="Afiliados" type="xs:int" />
              <xs:element msdata:ReadOnly="true" minOccurs="0" name="Saldo" type="xs:decimal" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:choice>
    </xs:complexType>
  </xs:element>
</xs:schema>