<?xml version="1.0" encoding="utf-8"?>

<xs:schema xmlns="http://tempuri.org/DsCaja.xsd" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata"
           xmlns:mstns="http://tempuri.org/DsCaja.xsd" attributeFormDefault="qualified" elementFormDefault="qualified"
           targetNamespace="http://tempuri.org/DsCaja.xsd" id="DsCaja" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element msdata:IsDataSet="true" msdata:UseCurrentLocale="true" name="DsCaja">
