      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="Caja">
          <xs:complexType>
            <xs:sequence>
              <xs:element msdata:ReadOnly="true" minOccurs="0" name="Fecha_x0020_y_x0020_Hora" type="xs:dateTime" />
