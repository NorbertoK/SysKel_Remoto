<?xml version="1.0" encoding="utf-8"?>

<xs:schema xmlns="http://tempuri.org/DS_ReportPago.xsd" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata"
           xmlns:mstns="http://tempuri.org/DS_ReportPago.xsd" attributeFormDefault="qualified"
           elementFormDefault="qualified" targetNamespace="http://tempuri.org/DS_ReportPago.xsd" id="DsReportPago"
           xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element msdata:IsDataSet="true" msdata:UseCurrentLocale="true" name="DsReportPago">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="RepPago">
          <xs:complexType>
            <xs:sequence>
              <xs:element minOccurs="0" name="Fecha" type="xs:dateTime" />
              <xs:element minOccurs="0" name="Proveedor">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="200" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element msdata:ReadOnly="true" minOccurs="0" name="Caja">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="101" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element minOccurs="0" name="Grabador">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="10" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="RepPagoCompras">
          <xs:complexType>
            <xs:sequence>
              <xs:element msdata:ReadOnly="true" minOccurs="0" name="ImporteCompra" type="xs:decimal" />
