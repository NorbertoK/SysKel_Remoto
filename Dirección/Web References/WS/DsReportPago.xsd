              <xs:element minOccurs="0" name="Observaciones">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="2147483647" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element minOccurs="0" name="Comprobante">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
