<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:mstns="http://tempuri.org/DS_ImportarPadron.xsd" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" xmlns="http://tempuri.org/DS_ImportarPadron.xsd" attributeFormDefault="qualified" elementFormDefault="qualified" targetNamespace="http://tempuri.org/DS_ImportarPadron.xsd" id="DsImportarPadron" xmlns:xs="http://www.w3.org/2001/XMLSchema">
